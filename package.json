{
  "name": "takip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node tools/prepare-map-worker.mjs",
    "dev": "node tools/dev.mjs",
    "predev:web": "node tools/prepare-map-worker.mjs",
    "dev:web": "next dev",
    "dev:api": "npm run dev -w @takip/api",
    "prebuild": "node tools/prepare-map-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "RUN_LIVE_TESTS=1 vitest run",
    "plan": "npm run plan -w @takip/api --",
    "admin": "npm run admin -w @takip/api --",
    "ingest": "npm run ingest -w @takip/ingest --",
    "import": "tsx tools/import/cli.ts",
    "i18n": "tsx tools/i18n/cli.ts",
    "shorts": "tsx tools/shorts/cli.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@mapbox/mapbox-gl-rtl-text": "0.3.0",
    "@takip/archive": "*",
    "@takip/connectors": "*",
    "@takip/core": "*",
    "@vercel/analytics": "^2.0.1",
    "adhan": "^4.4.6",
    "better-auth": "^1.7.7",
    "framer-motion": "^12.38.0",
    "google-libphonenumber": "^3.2.44",
    "hls.js": "^1.6.16",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "6.7.0",
    "next": "16.3.8",
    "onnxruntime-web": "1.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-map-gl": "^8.1.1",
    "rss-parser": "^3.13.0",
    "satellite.js": "^7.0.0",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "uqr": "0.1.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@anthropic-ai/sdk": "^0.135.0",
    "@tailwindcss/postcss": "^4",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
