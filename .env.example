# ═══════════════════════════════════════════════════════════════════════════
#  TAKIP — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  TAKIP works fully WITHOUT any third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  The RECON toolkit is now fully keyless too: TLS, port scan, security
#  headers, tech fingerprint, subdomains, vulnerabilities, reputation and the
#  rest run from public feeds and the server's own sockets — no backend and no
#  API key. Every key below is OPTIONAL, for higher rate limits or future
#  sources; set one only if you extend the code or hit a public-feed limit.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  CLOUDFLARE RADAR  ── read by the code; enables two map layers ──
#  Powers the "Internet Outages" and "Attack Origins" layers under
#  NET & EVENT INTEL (https://radar.cloudflare.com/).
#  Free: any Cloudflare account → My Profile → API Tokens → Create Token →
#  Custom token with permission "Account · Radar · Read".
#  Leave empty to disable — /api/cloudflare-radar returns 503 and both layer
#  toggles stay hidden in the UI. The GDELT Events layer is unaffected and
#  needs no key.
# ─────────────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
#  CHAIN INTEL  ── optional; the RECON "CHAIN INTEL" tab works without these ──
#  Baseline wallet forensics (BTC/ETH/SOL balance, transaction history,
#  counterparties, OFAC SDN screening, risk scoring) is fully keyless via
#  mempool.space, Blockscout and the public Solana RPC.
#
#  These only deepen it; /api/osint/crypto?probe=1 reports which are active:
#    ETHERSCAN_API_KEY  https://etherscan.io/apis  — internal txs, richer ETH
#    HELIUS_API_KEY     https://helius.dev         — parsed Solana transfers.
#                       Without it, SOL transfer amounts and counterparties
#                       stay blank: the public RPC lists signatures only.
# ─────────────────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
HELIUS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  PROFILE SEARCH  ── optional; RECON's profile search works without it ──
#  GITHUB_TOKEN  any GitHub token, no scopes needed. Raises GitHub's limits
#                from 60 profile reads an hour and 10 searches a minute, so
#                found GitHub profiles and the email → commits lookup keep
#                answering on busy days.
# ─────────────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
#  GOOGLE ADSENSE  ── optional; read by src/lib/ads.ts ──
#  Leave CLIENT empty for no ads, no Google script and no ad-blocker check
#  (self-hosting, dev). CLIENT is the publisher ID (ca-pub-…); /ads.txt is
#  served from it. Each SLOT is a display ad unit's data-ad-slot (AdSense →
#  Ads → By ad unit); a placement without one stays empty:
#    PANEL  under the browsing sidebar panels (Layers, Alerts, Space, …)
#    PAGE   in the docs, between the guide and the API reference
#  In AdSense, turn on the EEA/UK consent message (Privacy & messaging) and
#  keep Auto ads off: the slots are placed by hand, away from the map.
#  Plans with the ads.off entitlement (Pro) never load any of it.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_PANEL=
NEXT_PUBLIC_ADSENSE_SLOT_PAGE=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  AI, INGEST AND BACKENDS
# ─────────────────────────────────────────────────────────────────────────
# These are read by the code but were missing from this file, so a deployment
# could not tell which of them gate what. The two secrets fail closed: with
# them unset their endpoints answer 503 rather than running unauthenticated.

# Google Gemini, for /api/ai/analyze, /api/ai/briefing and /api/ai/overview.
# Numbered from 1; several may be set and are rotated between. With none set
# the AI endpoints answer 503, or fall back to the heuristic analyst, and a
# reader can still supply their own key from the settings panel.
# GEMINI_API_KEY_1=

# Shared secret for POST /api/sdk/ingest. Unset, the endpoint is disabled.
# SDK_INGEST_KEY=

# GitHub webhook HMAC secret and the URL verified payloads are forwarded to.
# Unset, /api/github-webhook is disabled. Both are required together.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_FORWARD_URL=

# Entity resolution service (intel/) for /api/v1/entity/expand, read by the api.
# Unset: http://takip-intel:4000 in production, http://localhost:4000 otherwise.
# INTEL_URL=

# ─────────────────────────────────────────────────────────────────────────
#  ACCOUNTS  ── the api service in apps/api (started by npm run dev) ──
#  The web app proxies /api/auth/* to it, so sign-in stays on one origin.
# ─────────────────────────────────────────────────────────────────────────
# Signs session cookies and encrypts stored provider tokens. 32+ random
# characters; required in production.
#   openssl rand -base64 32
# BETTER_AUTH_SECRET=
# The origin the browser uses for the web app.
# BETTER_AUTH_URL=http://localhost:3000
# Where the web app reaches the api. Read at build time (next.config.ts).
# API_INTERNAL_URL=http://127.0.0.1:4100
# API_HOST=127.0.0.1
# API_PORT=4100
# Peers whose X-Forwarded-For the api believes, as IPs or CIDR ranges. The
# default, loopback, is the Next rewrite in development. Next passes on the
# client's own X-Forwarded-For, so in production put nginx (or another proxy
# that overwrites or appends it) in front and list only its address.
# TRUSTED_PROXIES=127.0.0.0/8,::1
# Cloudflare is the edge: believe cf-connecting-ip from a trusted peer.
# CLOUDFLARE_EDGE=false
# Accounts database; defaults to data/db/app.db in the repo.
# APP_DB_PATH=
# Days of per-day usage counts kept in it (pruned daily): for accounts and
# their API keys, and for anonymous visitors.
# USAGE_RETENTION_DAYS=400
# USAGE_ANON_RETENTION_DAYS=35
# Days of account history (audit_event) kept, pruned daily.
# AUDIT_RETENTION_DAYS=30
# Days finished background jobs (sent mail included) are kept, pruned daily.
# JOB_RETENTION_DAYS=7
# Where the nightly snapshot of the accounts database goes (defaults to
# data/backups in the repo), and how many daily snapshots stay there.
# Restoring one: docs/runbooks/app-db-restore.md.
# APP_BACKUP_DIR=
# APP_BACKUP_KEEP=14
# Outgoing mail (verification and password-reset links), from any provider
# that offers SMTP. Both required in production. Unset in development: each
# message, link included, is printed in the npm run dev terminal instead.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=TAKIP <no-reply@example.com>
# api log level: fatal, error, warn, info, debug, trace or silent. JSON lines,
# except under npm run dev, where they print as short [api] lines.
# LOG_LEVEL=info
# Peers besides loopback that may read the api's GET /metrics (e.g. the
# Prometheus host), as comma-separated CIDRs. Anyone else gets a 404.
# METRICS_ALLOW=10.0.0.0/8
# Payment provider for /api/billing (stripe, paddle, polar, lemonsqueezy or
# iyzico once its adapter exists; none does yet). Unset: billing is off and
# checkout answers 501. Each adapter adds its own keys and webhook secret.
# BILLING_PROVIDER=
#
# Social sign-in. Each button appears once both its id and secret are set.
# Register this redirect URI with the provider (id: google, facebook, apple,
# microsoft, github, twitter, discord):
#   <BETTER_AUTH_URL>/api/auth/callback/<id>
# Google: Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Facebook: developers.facebook.com → app → Facebook Login → Valid OAuth
# Redirect URIs. The app must be Live and ask for the email permission.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# Apple: a Services ID is the client id; the secret is a JWT you sign with
# your Apple key (it expires within 6 months). Needs https on a real domain.
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# Microsoft: Entra ID → App registrations, personal and work accounts.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GitHub: Settings → Developer settings → OAuth Apps.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# X: developer portal → OAuth 2.0; turn on "Request email from users".
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Discord: developer portal → OAuth2.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
TAKIP_PORT=3000

# Comma-separated list of public Telegram channel usernames (no @) to scrape
# for the "Telegram OSINT" map layer. Overrides the curated default set.
# Channels must have web preview enabled (most well-known OSINT channels do).
# Default if unset:
#   osintdefender,insiderpaper,aljazeeraenglish,nexta_live,war_monitor
# TAKIP_TELEGRAM_CHANNELS=

# Raw feed archive (docs/architecture/replay-database.md §7.1): every upstream
# payload the live routes receive is appended to hourly NDJSON+zstd files under
# <dir>/raw/. Replay history is rebuilt from it, so recording should start as
# early as possible. About 0.85 GB/day with AIS and OpenSky. Unset: off.
# TAKIP_ARCHIVE_DIR=./data/archive
# Below this much free disk the recorder pauses AIS, then OpenSky, then all.
# TAKIP_ARCHIVE_MIN_FREE_GB=50
# The replay database files (catalog.db, tracks/, …) for apps/ingest and apps/api.
# TAKIP_DATA_DIR=./data
# Where the ingest worker reaches the web app while the live feeds still poll
# from there (it keeps them polling so the archive has no traffic-shaped gaps).
# TAKIP_WEB_URL=http://127.0.0.1:3000

# The visitor's address for the web routes' per-IP limits. Route handlers
# can't see the socket peer and Next keeps a client-sent X-Forwarded-For, so:
# how many proxies in front of Next append to X-Forwarded-For (0 when Next
# faces the internet: then no header is believed and all callers share one
# limit), and/or a header your edge overwrites (cf-connecting-ip, x-real-ip,
# x-vercel-forwarded-for).
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
